# Copy this file to `.env` and fill in the values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection. `npm run db:migrate` creates the database if it doesn't exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kzfr

# How long an admin stays logged in (hours).
SESSION_TTL_HOURS=168

# Only needed if the frontend is served from a different origin than the API
# (comma-separated). Not needed in dev: Vite proxies /api to this server.
CORS_ORIGIN=

# Number of reverse proxies in front of the app in production (Nginx, Render, Railway...: usually 1).
# Leave unset on Vercel: it defaults to 1 there automatically.
TRUST_PROXY=0

# --- Email (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST empty to print emails to the console instead of sending them.
# Gmail: smtp.gmail.com / 587 / your address / an App Password (not your normal password).
# Brevo, Resend, Mailgun, SendGrid, etc. all provide SMTP credentials too.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KZFR Studio <hello@kzfr.studio>"

# Where "new contact message" / "new order" notifications are sent. Leave empty to disable.
ADMIN_NOTIFY_EMAIL=
